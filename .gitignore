# --- Data & models -------------------------------------------------------
# By default we do NOT commit raw or processed data or trained models...
data/raw/*
data/processed/*
models/*

# ...but we DO commit the small synthetic demo artefacts and the pilot model
# so the repo runs (API + dashboard) immediately after cloning. These are
# SYNTHETIC prototype artefacts, not real operational data.
!data/raw/.gitkeep
!data/processed/.gitkeep
!models/.gitkeep
!data/synthetic/
!data/synthetic/*.csv
!models/lotiq_chilli.pkl
!models/metrics.json
